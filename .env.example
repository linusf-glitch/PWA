# Copy to .env.local for local development. Never commit real values.
# Both values are public by design (they ship in the browser); the privacy
# comes from row-level security in the database. NEVER put the Supabase
# service_role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shopify Storefront API (public token, read products + create carts only).
# Domain looks like your-shop.myshopify.com.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Test helper: "true" shows a "Test: Zahlung simulieren" button on Farbe wählen. Set it in Vercel for
# the Preview environment only, never Production.
VITE_TEST_TOOLS=

# Server only (Vercel environment variables, NEVER a VITE_ name, never in client code):
# SUPABASE_URL                optional, same as VITE_SUPABASE_URL (used when only the server needs it)
# SHOPIFY_WEBHOOK_SECRET      signing secret Shopify shows for the "Order payment" webhook
# SUPABASE_SERVICE_ROLE_KEY   Supabase service role key (full access, keep secret)
